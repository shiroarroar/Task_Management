function handleAddComment(payload, user) {
  const taskId = payload.task_id;
  const content = String(payload.content || '').trim();
  if (!taskId || !content) return { ok: false, error: '留言內容不可為空' };

  const tasks = readSheetAsObjects(SHEETS.TASKS);
  const task = tasks.find(t => t.task_id === taskId);
  if (!task || !canViewTask(user, task)) return { ok: false, error: '找不到任務或無權限留言' };

  const users = readSheetAsObjects(SHEETS.USERS);
  const mentionedUserIds = [];
  users.forEach(u => {
    if (
      content.indexOf('@' + u.username) !== -1 ||
      content.indexOf('@' + u.display_name) !== -1
    ) {
      if (mentionedUserIds.indexOf(u.user_id) === -1) {
        mentionedUserIds.push(u.user_id);
      }
    }
  });

  const commentId = 'cmt_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();
  appendRow(SHEETS.COMMENTS, [
    commentId,
    taskId,
    user.user_id,
    content,
    JSON.stringify(mentionedUserIds),
    now
  ]);

  mentionedUserIds.forEach(targetId => {
    if (targetId !== user.user_id) {
      createNotification(
        targetId,
        taskId,
        'mention',
        `${user.display_name} 在任務「${task.title}」留言中標記了您：「${content.slice(0, 40)}」`,
        true
      );
    }
  });

  logActivity(user.user_id, taskId, 'add_comment', '新增留言');
  return {
    ok: true,
    comment: {
      comment_id: commentId,
      task_id: taskId,
      author_id: user.user_id,
      content: content,
      mentions: mentionedUserIds,
      created_at: now
    }
  };
}

function handleMarkNotificationsRead(payload, user) {
  const notifId = payload.notif_id || '';
  const sheet = getSpreadsheet().getSheetByName(SHEETS.NOTIFICATIONS);
  const data = sheet.getDataRange().getValues();
  const headers = data[0];
  const idIdx = headers.indexOf('notif_id');
  const userIdx = headers.indexOf('user_id');
  const readIdx = headers.indexOf('is_read');

  for (let i = 1; i < data.length; i++) {
    if (data[i][userIdx] === user.user_id) {
      if (!notifId || data[i][idIdx] === notifId) {
        sheet.getRange(i + 1, readIdx + 1).setValue('true');
      }
    }
  }
  return { ok: true };
}

function dailyDueNotificationTrigger() {
  const tasks = readSheetAsObjects(SHEETS.TASKS).filter(
    t => String(t.is_archived) !== 'true' && t.status !== 'done' && t.due_date
  );
  const users = readSheetAsObjects(SHEETS.USERS).filter(u => u.status === 'active');
  const userMap = {};
  users.forEach(u => { userMap[u.user_id] = u; });

  const today = todayYmd();
  const tomorrow = computeNextDate(today, 'daily');
  const groupedByUser = {};

  tasks.forEach(t => {
    const assignees = parseAssigneeIds(t.assignee_id);
    if (!assignees.length || t.due_date > tomorrow) return;
    assignees.forEach(uid => {
      if (!userMap[uid]) return;
      if (!groupedByUser[uid]) groupedByUser[uid] = [];
      groupedByUser[uid].push(t);
    });
  });

  Object.keys(groupedByUser).forEach(uid => {
    const u = userMap[uid];
    const list = groupedByUser[uid];
    if (!u.email) return;

    const lines = list.map(t => {
      const tag = t.due_date < today ? '[已逾期]' : (t.due_date === today ? '[今日到期]' : '[明日到期]');
      return `- ${tag} ${t.title}（截止：${t.due_date}）`;
    });

    const subject = `[TaskFlow 任務提醒] 您有 ${list.length} 項即將到期或已逾期任務`;
    const body =
      `${u.display_name} 您好：\n\n以下是您目前需要優先處理的任務：\n\n` +
      lines.join('\n') +
      (CONFIG.FRONTEND_URL ? `\n\n前往任務系統：${CONFIG.FRONTEND_URL}` : '');

    try {
      MailApp.sendEmail(u.email, subject, body);
      createNotification(uid, list[0].task_id, 'due_soon', `您有 ${list.length} 項任務即將到期或已逾期`, false);
    } catch (err) {
      Logger.log('寄送每日提醒失敗: ' + err.message);
    }
  });
}

// ============================================================================
// 8.5 工時追蹤 (TimeLogs)
// ============================================================================
function handleLogTime(payload, user) {
  const taskId = payload.task_id;
  const hours = Number(payload.hours || 0);
  const workDate = String(payload.work_date || todayYmd()).slice(0, 10);
  const note = String(payload.note || '').trim();

  if (!taskId || !hours || hours <= 0 || hours > 24) {
    return { ok: false, error: '請輸入 0.01 至 24 小時之間的有效工時' };
  }
  const access = assertTaskEditAccess(taskId, user);
  if (access.error) return { ok: false, error: access.error };

  const ss = getSpreadsheet();
  ensureSheetExists(ss, SHEETS.TIME_LOGS, getSheetSchemas()[SHEETS.TIME_LOGS]);

  const logId = 'tl_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();
  appendRow(SHEETS.TIME_LOGS, [
    logId, taskId, user.user_id, hours, workDate, note, now
  ]);

  recalcTaskActualHours(taskId);
  logActivity(user.user_id, taskId, 'log_time', `記錄工時 ${hours} 小時`);

  return {
    ok: true,
    timeLog: {
      log_id: logId,
      task_id: taskId,
      user_id: user.user_id,
      hours: hours,
      work_date: workDate,
      note: note,
      created_at: now
    }
  };
}

function handleDeleteTimeLog(payload, user) {
  const logId = payload.log_id;
  if (!logId) return { ok: false, error: '缺少工時紀錄 ID' };

  const logs = readSheetAsObjects(SHEETS.TIME_LOGS);
  const target = logs.find(l => l.log_id === logId);
  if (!target) return { ok: false, error: '找不到指定工時紀錄' };

  const access = assertTaskEditAccess(target.task_id, user);
  if (access.error) return { ok: false, error: access.error };
  if (user.role === 'member' && target.user_id !== user.user_id) {
    return { ok: false, error: '僅能刪除自己的工時紀錄' };
  }

  deleteRowByMatch(SHEETS.TIME_LOGS, 'log_id', logId);
  recalcTaskActualHours(target.task_id);
  return { ok: true, log_id: logId };
}

function recalcTaskActualHours(taskId) {
  const logs = readSheetAsObjects(SHEETS.TIME_LOGS).filter(l => l.task_id === taskId);
  const total = logs.reduce((sum, l) => sum + Number(l.hours || 0), 0);
  updateRowById(SHEETS.TASKS, 'task_id', taskId, {
    actual_hours: Math.round(total * 100) / 100,
    updated_at: nowIso()
  });
}

