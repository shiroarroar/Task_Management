function handleAddAttachmentLink(payload, user) {
  const taskId = payload.task_id;
  const name = String(payload.name || '').trim();
  const url = String(payload.url || '').trim();
  if (!taskId || !name || !url) return { ok: false, error: '請填寫附件名稱與連結網址' };
  if (!/^https?:\/\//i.test(url)) return { ok: false, error: '僅允許 http:// 或 https:// 外部連結' };
  const access = assertTaskEditAccess(taskId, user);
  if (access.error) return { ok: false, error: access.error };

  const attId = 'att_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();
  appendRow(SHEETS.ATTACHMENTS, [
    attId, taskId, name, url, 'link', '', user.user_id, now
  ]);
  logActivity(user.user_id, taskId, 'add_attachment', '新增連結附件：' + name);
  return {
    ok: true,
    attachment: {
      attachment_id: attId,
      task_id: taskId,
      name: name,
      url: url,
      source_type: 'link',
      drive_file_id: '',
      uploaded_by: user.user_id,
      created_at: now
    }
  };
}

function handleUploadAttachmentFile(payload, user) {
  const taskId = payload.task_id;
  const fileName = String(payload.file_name || 'attachment');
  const mimeType = String(payload.mime_type || 'application/octet-stream');
  const base64Data = String(payload.base64_data || '');

  if (!taskId || !base64Data) return { ok: false, error: '檔案資料不完整' };
  const access = assertTaskEditAccess(taskId, user);
  if (access.error) return { ok: false, error: access.error };

  const folder = getOrCreateAttachmentFolder();
  const decoded = Utilities.base64Decode(base64Data);
  const blob = Utilities.newBlob(decoded, mimeType, fileName);
  const file = folder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  const fileUrl = file.getUrl();
  const fileId = file.getId();
  const attId = 'att_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();

  appendRow(SHEETS.ATTACHMENTS, [
    attId, taskId, fileName, fileUrl, 'drive', fileId, user.user_id, now
  ]);
  logActivity(user.user_id, taskId, 'upload_attachment', '上傳檔案至 Drive：' + fileName);

  return {
    ok: true,
    attachment: {
      attachment_id: attId,
      task_id: taskId,
      name: fileName,
      url: fileUrl,
      source_type: 'drive',
      drive_file_id: fileId,
      uploaded_by: user.user_id,
      created_at: now
    }
  };
}

function handleDeleteAttachment(payload, user) {
  const att = readSheetAsObjects(SHEETS.ATTACHMENTS).find(a => a.attachment_id === payload.attachment_id);
  if (!att) return { ok: false, error: '找不到指定附件' };
  const access = assertTaskEditAccess(att.task_id, user);
  if (access.error) return { ok: false, error: access.error };

  deleteRowByMatch(SHEETS.ATTACHMENTS, 'attachment_id', payload.attachment_id);
  return { ok: true, attachment_id: payload.attachment_id };
}

