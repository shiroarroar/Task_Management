  DRIVE_FOLDER_ID: '1KVgCcqjQLFCEuyyG3mcn3Dv5lYUh6PKn',
  // Token 有效小時數
  SESSION_HOURS: 24,
  // 密碼雜湊固定鹽值前綴（建議部署前自行修改為隨機字串）
  APP_SECRET_SALT: 'TaskFlow_TW_2026_Secret!',
  // 是否啟用真實 Email 寄信（指派與 @標記時即時寄信；每日到期提醒則透過觸發器執行）
