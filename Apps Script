const DATA_VERSION_KEY = 'TASKFLOW_DATA_VERSION';

const SHEETS = {
  USERS: 'Users',
  SESSIONS: 'Sessions',
  TASKS: 'Tasks',
  SUBTASKS: 'Subtasks',
  ATTACHMENTS: 'Attachments',
  COMMENTS: 'Comments',
  NOTIFICATIONS: 'Notifications',
  ACTIVITY_LOGS: 'ActivityLogs',
  TIME_LOGS: 'TimeLogs'
};

function getSheetSchemas() {
  return {
    [SHEETS.USERS]: [
      'user_id', 'username', 'password_hash', 'salt', 'display_name',
      'email', 'role', 'department', 'status', 'created_at'
    ],
    [SHEETS.SESSIONS]: [
      'token', 'user_id', 'expires_at', 'created_at'
    ],
    [SHEETS.TASKS]: [
      'task_id', 'title', 'description', 'status', 'priority', 'tags',
      'department', 'assignee_id', 'creator_id', 'start_date', 'due_date',
      'recurrence', 'dependencies', 'estimated_hours', 'actual_hours',
      'is_archived', 'created_at', 'updated_at'
    ],
    [SHEETS.SUBTASKS]: [
      'subtask_id', 'task_id', 'title', 'is_done', 'item_type',
      'assignee_id', 'sort_order', 'created_at'
    ],
    [SHEETS.ATTACHMENTS]: [
      'attachment_id', 'task_id', 'name', 'url', 'source_type',
      'drive_file_id', 'uploaded_by', 'created_at'
    ],
    [SHEETS.COMMENTS]: [
      'comment_id', 'task_id', 'author_id', 'content', 'mentions', 'created_at'
    ],
    [SHEETS.NOTIFICATIONS]: [
      'notif_id', 'user_id', 'task_id', 'type', 'message', 'is_read', 'created_at'
    ],
    [SHEETS.ACTIVITY_LOGS]: [
      'log_id', 'user_id', 'task_id', 'action', 'detail', 'created_at'
    ],
    [SHEETS.TIME_LOGS]: [
      'log_id', 'task_id', 'user_id', 'hours', 'work_date', 'note', 'created_at'
    ]
  };
}

function ensureSheetExists(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
  }
  if (sheet.getLastRow() === 0 && headers && headers.length) {
    sheet.appendRow(headers);
    sheet.getRange(1, 1, 1, headers.length)
      .setFontWeight('bold')
      .setBackground('#1e293b')
      .setFontColor('#ffffff');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

// ============================================================================
// 1. 資料庫初始化 (首次使用請手動執行一次)
// ============================================================================
function setupDatabase() {
  const ss = getSpreadsheet();
  const schemas = getSheetSchemas();

  Object.keys(schemas).forEach(name => {
    ensureSheetExists(ss, name, schemas[name]);
  });

  // 若 Users 尚無任何帳號，建立預設管理員 admin / admin123
  const usersSheet = ss.getSheetByName(SHEETS.USERS);
  if (usersSheet.getLastRow() <= 1) {
    const salt = Utilities.getUuid().slice(0, 8);
    const hash = hashPassword('admin123', salt);
    usersSheet.appendRow([
      'usr_' + Utilities.getUuid().slice(0, 8),
      'admin',
      hash,
      salt,
      '系統管理員',
      Session.getActiveUser().getEmail() || '',
      'admin',
      '管理部',
      'active',
      nowIso()
    ]);
  }

  Logger.log('資料庫初始化完成！預設管理員帳號：admin / 密碼：admin123（登入後請盡快修改密碼）');
}

// ============================================================================
// 2. HTTP 進入點 (支援 CORS、text/plain JSON 與版本號輕量同步)
// ============================================================================
function doGet(e) {
  return jsonResponse({
    ok: true,
    message: 'TaskFlow GAS API 運作中',
    timestamp: nowIso()
  });
}

function doPost(e) {
  try {
    const raw = e && e.postData && e.postData.contents ? e.postData.contents : '{}';
    const req = JSON.parse(raw);
    const action = req.action || '';
    const payload = req.payload || {};
    const token = req.token || '';

    // 不需登入的公開操作
    if (action === 'login') {
      return jsonResponse(handleLogin(payload));
    }
    if (action === 'ping') {
      return jsonResponse({ ok: true, message: '連線成功', timestamp: nowIso() });
    }

    // 其餘操作皆需驗證 Token
    const currentUser = authenticateToken(token);
    if (!currentUser) {
      return jsonResponse({ ok: false, error: '登入已逾時或無效的憑證，請重新登入', code: 'UNAUTHORIZED' });
    }

    // 輕量版本號檢查（不讀取試算表，僅讀取快取／屬性）
    if (action === 'checkUpdates') {
      return jsonResponse({ ok: true, data_version: getDataVersion() });
    }

    // 寫入類操作使用 LockService 防止多人併發覆蓋
    const writeActions = [
      'logout', 'changePassword', 'createTask', 'updateTask', 'moveTask', 'archiveTask',
      'saveSubtask', 'toggleSubtask', 'deleteSubtask',
      'addAttachmentLink', 'uploadAttachmentFile', 'deleteAttachment',
      'addComment', 'markNotificationsRead',
      'logTime', 'deleteTimeLog',
      'adminCreateUser', 'adminUpdateUser', 'adminResetPassword'
    ];

    // 會影響多使用者畫面資料的寫入操作（成功後自動推進全域版本號）
    const versionBumpActions = [
      'createTask', 'updateTask', 'moveTask', 'archiveTask',
      'saveSubtask', 'toggleSubtask', 'deleteSubtask',
      'addAttachmentLink', 'uploadAttachmentFile', 'deleteAttachment',
      'addComment', 'logTime', 'deleteTimeLog',
      'adminCreateUser', 'adminUpdateUser'
    ];

    let result;
    if (writeActions.indexOf(action) !== -1) {
      const lock = LockService.getScriptLock();
      lock.waitLock(15000);
      try {
        result = dispatchAction(action, payload, currentUser, token);
        if (result && result.ok && versionBumpActions.indexOf(action) !== -1) {
          result.data_version = bumpDataVersion();
        }
      } finally {
        lock.releaseLock();
      }
    } else {
      result = dispatchAction(action, payload, currentUser, token);
    }

    return jsonResponse(result);
  } catch (err) {
    return jsonResponse({ ok: false, error: err.message || String(err) });
  }
}

function dispatchAction(action, payload, user, token) {
  switch (action) {
    case 'logout': return handleLogout(token);
    case 'getBootstrap': return handleGetBootstrap(user);
    case 'changePassword': return handleChangePassword(payload, user);

    case 'createTask': return handleCreateTask(payload, user);
    case 'updateTask': return handleUpdateTask(payload, user);
    case 'moveTask': return handleMoveTask(payload, user);
    case 'archiveTask': return handleArchiveTask(payload, user);

    case 'saveSubtask': return handleSaveSubtask(payload, user);
    case 'toggleSubtask': return handleToggleSubtask(payload, user);
    case 'deleteSubtask': return handleDeleteSubtask(payload, user);

    case 'addAttachmentLink': return handleAddAttachmentLink(payload, user);
    case 'uploadAttachmentFile': return handleUploadAttachmentFile(payload, user);
    case 'deleteAttachment': return handleDeleteAttachment(payload, user);

    case 'addComment': return handleAddComment(payload, user);
    case 'markNotificationsRead': return handleMarkNotificationsRead(payload, user);

    case 'logTime': return handleLogTime(payload, user);
    case 'deleteTimeLog': return handleDeleteTimeLog(payload, user);

    case 'adminCreateUser': return handleAdminCreateUser(payload, user);
    case 'adminUpdateUser': return handleAdminUpdateUser(payload, user);
    case 'adminResetPassword': return handleAdminResetPassword(payload, user);

    default:
      return { ok: false, error: '未知的操作指令: ' + action };
  }
}

function getDataVersion() {
  const cache = CacheService.getScriptCache();
  let ver = cache.get(DATA_VERSION_KEY);
  if (!ver) {
    ver = PropertiesService.getScriptProperties().getProperty(DATA_VERSION_KEY) || String(Date.now());
    cache.put(DATA_VERSION_KEY, ver, 21600);
  }
  return ver;
}

function bumpDataVersion() {
  const ver = String(Date.now());
  PropertiesService.getScriptProperties().setProperty(DATA_VERSION_KEY, ver);
  CacheService.getScriptCache().put(DATA_VERSION_KEY, ver, 21600);
  return ver;
}

// ============================================================================
// 3. 帳號認證與三級權限管理
// ============================================================================
function handleLogin(payload) {
  const username = String(payload.username || '').trim();
  const password = String(payload.password || '');
  if (!username || !password.trim()) {
    return { ok: false, error: '請輸入帳號與密碼' };
  }

  const users = readSheetAsObjects(SHEETS.USERS);
  const user = users.find(u => String(u.username || '').trim() === username);
  if (!user || !user.password_hash || !user.salt) {
    return { ok: false, error: '帳號或密碼錯誤' };
  }
  if (user.status !== 'active') {
    return { ok: false, error: '此帳號已被停用，請聯繫系統管理員' };
  }

  const inputHash = hashPassword(password, user.salt);
  if (inputHash !== user.password_hash) {
    return { ok: false, error: '帳號或密碼錯誤' };
  }

  const token = 'tk_' + Utilities.getUuid().replace(/-/g, '');
  const expiresAt = new Date(Date.now() + CONFIG.SESSION_HOURS * 3600 * 1000).toISOString();
  appendRow(SHEETS.SESSIONS, [token, user.user_id, expiresAt, nowIso()]);

  return {
    ok: true,
    token: token,
    user: sanitizeUser(user)
  };
}

function handleLogout(token) {
  deleteRowByMatch(SHEETS.SESSIONS, 'token', token);
  return { ok: true };
}

function handleChangePassword(payload, user) {
  const oldPassword = String(payload.old_password || '');
  const newPassword = String(payload.new_password || '');
  if (newPassword.length < 6) {
    return { ok: false, error: '新密碼長度至少需 6 個字元' };
  }
  const users = readSheetAsObjects(SHEETS.USERS);
  const fullUser = users.find(u => u.user_id === user.user_id);
  if (!fullUser || hashPassword(oldPassword, fullUser.salt) !== fullUser.password_hash) {
    return { ok: false, error: '目前密碼不正確' };
  }
  const newSalt = Utilities.getUuid().slice(0, 8);
  const newHash = hashPassword(newPassword, newSalt);
  updateRowById(SHEETS.USERS, 'user_id', user.user_id, {
    password_hash: newHash,
    salt: newSalt
  });
  return { ok: true, message: '密碼已更新' };
}

function authenticateToken(token) {
  if (!token || typeof token !== 'string' || !token.trim()) return null;
  const sessions = readSheetAsObjects(SHEETS.SESSIONS);
  const session = sessions.find(s => s.token && s.token === token && s.user_id);
  if (!session) return null;
  const expiresMs = new Date(session.expires_at).getTime();
  if (!expiresMs || expiresMs < Date.now()) {
    deleteRowByMatch(SHEETS.SESSIONS, 'token', token);
    return null;
  }
  const users = readSheetAsObjects(SHEETS.USERS);
  const user = users.find(u => u.user_id === session.user_id && u.status === 'active');
  return user ? sanitizeUser(user) : null;
}

// 權限判斷：Admin 看全部、Manager 看同部門、Member 看指派給自己（含共同負責）或自己建立的任務
function canViewTask(user, task) {
  if (String(task.is_archived) === 'true') return false;
  if (user.role === 'admin') return true;
  const isAssignee = parseAssigneeIds(task.assignee_id).indexOf(user.user_id) !== -1;
  if (user.role === 'manager') {
    return task.department === user.department || isAssignee || task.creator_id === user.user_id;
  }
  return isAssignee || task.creator_id === user.user_id;
}

function canEditTask(user, task) {
  if (user.role === 'admin') return true;
  const isAssignee = parseAssigneeIds(task.assignee_id).indexOf(user.user_id) !== -1;
  if (user.role === 'manager') {
    return task.department === user.department || isAssignee || task.creator_id === user.user_id;
  }
  return isAssignee || task.creator_id === user.user_id;
}

// ============================================================================
// 4. 初始資料載入 (Bootstrap)
// ============================================================================
function handleGetBootstrap(user) {
  const ss = getSpreadsheet();
  ensureSheetExists(ss, SHEETS.TIME_LOGS, getSheetSchemas()[SHEETS.TIME_LOGS]);

  const allUsers = readSheetAsObjects(SHEETS.USERS).map(u => {
    const safe = sanitizeUser(u);
    if (user.role !== 'admin' && safe.user_id !== user.user_id) {
      safe.email = '';
    }
    return safe;
  });
  const rawTasks = readSheetAsObjects(SHEETS.TASKS);
  const visibleTasks = rawTasks.filter(t => canViewTask(user, t));
  const visibleTaskIds = {};
  visibleTasks.forEach(t => {
    visibleTaskIds[t.task_id] = true;
  });

  const subtasks = readSheetAsObjects(SHEETS.SUBTASKS).filter(s => visibleTaskIds[s.task_id]);
  const attachments = readSheetAsObjects(SHEETS.ATTACHMENTS).filter(a => visibleTaskIds[a.task_id]);
  const comments = readSheetAsObjects(SHEETS.COMMENTS).filter(c => visibleTaskIds[c.task_id]);
  const timeLogs = readSheetAsObjects(SHEETS.TIME_LOGS)
    .filter(l => visibleTaskIds[l.task_id])
    .map(l => ({ ...l, hours: Number(l.hours || 0) }))
    .sort((a, b) => (a.created_at < b.created_at ? 1 : -1));
  const notifications = readSheetAsObjects(SHEETS.NOTIFICATIONS)
    .filter(n => n.user_id === user.user_id)
    .sort((a, b) => (a.created_at < b.created_at ? 1 : -1))
    .slice(0, 50);

  return {
    ok: true,
    data_version: getDataVersion(),
    currentUser: user,
    users: allUsers,
    tasks: visibleTasks.map(normalizeTask),
    subtasks: subtasks.map(s => ({ ...s, is_done: String(s.is_done) === 'true' })),
    attachments: attachments,
    comments: comments.map(c => ({ ...c, mentions: safeJsonParse(c.mentions, []) })),
    timeLogs: timeLogs,
    notifications: notifications.map(n => ({ ...n, is_read: String(n.is_read) === 'true' }))
  };
}

// ============================================================================
// 5. 任務 CRUD 與重複任務處理
// ============================================================================
function handleCreateTask(payload, user) {
  const title = String(payload.title || '').trim();
  if (!title) return { ok: false, error: '任務名稱為必填' };

  const taskId = 'tsk_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();
  const department = user.role === 'admin'
    ? (payload.department || user.department)
    : user.department;
  const rawAssignees = payload.assignee_ids !== undefined
    ? payload.assignee_ids
    : (payload.assignee_id !== undefined ? payload.assignee_id : [user.user_id]);
  const assigneeIds = parseAssigneeIds(rawAssignees);

  const dependencies = Array.isArray(payload.dependencies)
    ? payload.dependencies
    : (payload.predecessor_id ? [String(payload.predecessor_id)] : []);

  const row = [
    taskId,
    title,
    String(payload.description || ''),
    payload.status || 'todo',
    payload.priority || 'medium',
    JSON.stringify(Array.isArray(payload.tags) ? payload.tags : []),
    department,
    JSON.stringify(assigneeIds),
    user.user_id,
    payload.start_date || '',
    payload.due_date || '',
    payload.recurrence || 'none',
    JSON.stringify(dependencies),
    Number(payload.estimated_hours || 0),
    Number(payload.actual_hours || 0),
    'false',
    now,
    now
  ];

  appendRow(SHEETS.TASKS, row);
  logActivity(user.user_id, taskId, 'create_task', '建立任務：' + title);

  assigneeIds.forEach(aid => {
    if (aid && aid !== user.user_id) {
      createNotification(
        aid,
        taskId,
        'assigned',
        `${user.display_name} 指派了任務「${title}」給您`,
        true
      );
    }
  });

  const created = readSheetAsObjects(SHEETS.TASKS).find(t => t.task_id === taskId);
  return { ok: true, task: normalizeTask(created) };
}

function handleUpdateTask(payload, user) {
  const taskId = payload.task_id;
  const tasks = readSheetAsObjects(SHEETS.TASKS);
  const existing = tasks.find(t => t.task_id === taskId);
  if (!existing) return { ok: false, error: '找不到指定任務' };
  if (!canEditTask(user, existing)) return { ok: false, error: '您沒有權限編輯此任務' };

  const prevStatus = existing.status;
  const prevAssignees = parseAssigneeIds(existing.assignee_id);
  const updates = {
    updated_at: nowIso()
  };

  const editableFields = [
    'title', 'description', 'status', 'priority', 'department',
    'start_date', 'due_date', 'recurrence',
    'estimated_hours', 'actual_hours'
  ];
  editableFields.forEach(f => {
    if (payload[f] !== undefined) updates[f] = payload[f];
  });
  let nextAssignees = prevAssignees;
  if (payload.assignee_ids !== undefined || payload.assignee_id !== undefined) {
    nextAssignees = parseAssigneeIds(payload.assignee_ids !== undefined ? payload.assignee_ids : payload.assignee_id);
    updates.assignee_id = JSON.stringify(nextAssignees);
  }
  if (payload.tags !== undefined) {
    updates.tags = JSON.stringify(Array.isArray(payload.tags) ? payload.tags : []);
  }
  if (payload.dependencies !== undefined) {
    updates.dependencies = JSON.stringify(Array.isArray(payload.dependencies) ? payload.dependencies : []);
  } else if (payload.predecessor_id !== undefined) {
    updates.dependencies = JSON.stringify(payload.predecessor_id ? [String(payload.predecessor_id)] : []);
  }

  updateRowById(SHEETS.TASKS, 'task_id', taskId, updates);
  logActivity(user.user_id, taskId, 'update_task', '更新任務內容');

  nextAssignees.forEach(aid => {
    if (aid && prevAssignees.indexOf(aid) === -1 && aid !== user.user_id) {
      createNotification(
        aid,
        taskId,
        'assigned',
        `${user.display_name} 將任務「${updates.title || existing.title}」指派給您`,
        true
      );
    }
  });

  let nextTask = null;
  if (prevStatus !== 'done' && updates.status === 'done') {
    const updatedObj = { ...existing, ...updates };
    if (updatedObj.recurrence && updatedObj.recurrence !== 'none') {
      nextTask = spawnNextRecurringTask(updatedObj, user);
    }
  }

  const latest = readSheetAsObjects(SHEETS.TASKS).find(t => t.task_id === taskId);
  return {
    ok: true,
    task: normalizeTask(latest),
    nextRecurringTask: nextTask ? normalizeTask(nextTask) : null
  };
}

function handleMoveTask(payload, user) {
  return handleUpdateTask({ task_id: payload.task_id, status: payload.status }, user);
}

function handleArchiveTask(payload, user) {
  const taskId = payload.task_id;
  const tasks = readSheetAsObjects(SHEETS.TASKS);
  const existing = tasks.find(t => t.task_id === taskId);
  if (!existing) return { ok: false, error: '找不到指定任務' };
  if (user.role === 'member' && existing.creator_id !== user.user_id) {
    return { ok: false, error: '僅管理員、主管或建立者可封存此任務' };
  }
  if (user.role === 'manager' && existing.department !== user.department) {
    return { ok: false, error: '無法封存其他部門的任務' };
  }

  updateRowById(SHEETS.TASKS, 'task_id', taskId, {
    is_archived: 'true',
    updated_at: nowIso()
  });
  logActivity(user.user_id, taskId, 'archive_task', '封存任務：' + existing.title);
  return { ok: true, task_id: taskId };
}

function spawnNextRecurringTask(completedTask, user) {
  const baseDateStr = completedTask.due_date || todayYmd();
  const nextDue = computeNextDate(baseDateStr, completedTask.recurrence);
  const nextStart = completedTask.start_date
    ? computeNextDate(completedTask.start_date, completedTask.recurrence)
    : '';

  const newTaskId = 'tsk_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();
  const row = [
    newTaskId,
    completedTask.title,
    completedTask.description || '',
    'todo',
    completedTask.priority || 'medium',
    typeof completedTask.tags === 'string' ? completedTask.tags : JSON.stringify(completedTask.tags || []),
    completedTask.department,
    completedTask.assignee_id,
    user.user_id,
    nextStart,
    nextDue,
    completedTask.recurrence,
    '[]',
    Number(completedTask.estimated_hours || 0),
    0,
    'false',
    now,
    now
  ];
  appendRow(SHEETS.TASKS, row);
  logActivity(user.user_id, newTaskId, 'recurring_spawn', '由週期任務自動建立下一期：' + completedTask.title);
  return readSheetAsObjects(SHEETS.TASKS).find(t => t.task_id === newTaskId);
}

// ============================================================================
// 6. 子任務與核對清單 (Subtasks & Checklist)
// ============================================================================
function assertTaskEditAccess(taskId, user) {
  const task = readSheetAsObjects(SHEETS.TASKS).find(t => t.task_id === taskId);
  if (!task || String(task.is_archived) === 'true') return { error: '找不到指定任務' };
  if (!canEditTask(user, task)) return { error: '您沒有權限操作此任務' };
  return { task: task };
}

function handleSaveSubtask(payload, user) {
  const taskId = payload.task_id;
  const title = String(payload.title || '').trim();
  if (!taskId || !title) return { ok: false, error: '缺少任務 ID 或項目名稱' };
  const access = assertTaskEditAccess(taskId, user);
  if (access.error) return { ok: false, error: access.error };

  const subtaskId = 'sub_' + Utilities.getUuid().slice(0, 8);
  const now = nowIso();
  const itemType = payload.item_type === 'checklist' ? 'checklist' : 'subtask';
  const row = [
    subtaskId,
    taskId,
    title,
    'false',
    itemType,
    payload.assignee_id || '',
    Number(payload.sort_order || Date.now()),
    now
  ];
  appendRow(SHEETS.SUBTASKS, row);
  return {
    ok: true,
    subtask: {
      subtask_id: subtaskId,
      task_id: taskId,
      title: title,
      is_done: false,
      item_type: itemType,
      assignee_id: payload.assignee_id || '',
      sort_order: Number(payload.sort_order || Date.now()),
      created_at: now
    }
  };
}

function handleToggleSubtask(payload, user) {
